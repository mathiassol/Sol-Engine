; Sol Engine — editor defaults.
; .gitattributes normalizes line endings at the commit boundary; this makes
; editors *produce* the right ones in the first place.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

; This file is the formatting contract, and the `format-hygiene` invariant
; enforces it on every push - indent, column limit, final newline, trailing
; whitespace and line endings are all checked against what is declared here.
;
; The root .clang-format is a deliberate no-op (`DisableFormat: true`) so that
; no editor reformats this hand-tuned tree on save. The house style for a *new*
; file lives at tools/house-style.clang-format, which nothing auto-discovers and
; whose header carries the measurement. See .claude/rules/cpp-conventions.md.
[*.{cpp,hpp,h,hlsl,hlsli}]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
; Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 4

; Windows shells require CRLF — matches .gitattributes.
[*.{bat,cmd,ps1}]
end_of_line = crlf

; Vendored third-party code keeps its upstream formatting.
[packages/*/third_party/**]
trim_trailing_whitespace = false
insert_final_newline = false
