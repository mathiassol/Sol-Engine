* text=auto eol=lf
*.hlsl text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.cmake text eol=lf
*.json text eol=lf

# Windows shells need CRLF. cmd.exe mis-parses multi-line if/for blocks in an
# LF-only .bat, which run.bat has.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these — today they survive only on git's NUL-byte heuristic.
*.png  binary
*.ico  binary
*.bin  binary
*.pak  binary
*.pdf  binary
*.pptx binary
*.wav  binary
